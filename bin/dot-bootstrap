#!/usr/bin/env bash
set -e

tags=""
skip_become_pass=""
start_at_task=""

while [[ $# -gt 0 ]]; do
  case $1 in
    --tags)
      tags="$2"
      shift 2
      ;;
    --skip-become-pass)
      skip_become_pass="--skip-become-pass"
      shift
      ;;
    --start-at-task)
      start_at_task="$2"
      shift 2
      ;;
    *)
      if [ -z "$tags" ]; then
        tags="$1"
      elif [ -z "$skip_become_pass" ] && [[ "$1" == "--skip-become-pass" ]]; then
        skip_become_pass="--skip-become-pass"
      elif [ -z "$start_at_task" ]; then
        start_at_task="$1"
      fi
      shift
      ;;
  esac
done

if [ -z "$tags" ]; then
  tags="all"
fi

if ! [ -x "$(command -v ansible)" ]; then
  # On macOS, use brew. On Linux, use apt if available.
  if [[ "$OSTYPE" == "darwin"* ]]; then
    brew install ansible
  elif command -v apt-get &> /dev/null; then
    sudo apt-get update && sudo apt-get install -y ansible
  fi
fi

ansible-galaxy install -r requirements.yml

ANSIBLE_OPTS=("--tags" "$tags")
if [ -n "$start_at_task" ]; then
  ANSIBLE_OPTS+=("--start-at-task" "$start_at_task")
fi

echo "Debug: tags=$tags"
echo "Debug: ANSIBLE_OPTS=${ANSIBLE_OPTS[*]}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(dirname "$SCRIPT_DIR")"

if [ "$skip_become_pass" == "--skip-become-pass" ]; then
  ansible-playbook -i "$DOTFILES_DIR/hosts" "$DOTFILES_DIR/dotfiles.yml" "${ANSIBLE_OPTS[@]}"
elif [ -n "$ANSIBLE_BECOME_PASSWORD_FILE" ]; then
  ansible-playbook -i "$DOTFILES_DIR/hosts" "$DOTFILES_DIR/dotfiles.yml" --become-password-file "$ANSIBLE_BECOME_PASSWORD_FILE" "${ANSIBLE_OPTS[@]}"
else
  ansible-playbook -i "$DOTFILES_DIR/hosts" "$DOTFILES_DIR/dotfiles.yml" --ask-become-pass "${ANSIBLE_OPTS[@]}"
fi

