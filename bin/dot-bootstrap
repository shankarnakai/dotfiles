#!/usr/bin/env bash
set -e

# Default action is 'install'
ACTION="install"
TAGS="all"
SKIP_BECOME_PASS=""
START_AT_TASK=""

# Check if the first argument is a subcommand
case $1 in
  install|uninstall|check-updates|upgrade)
    ACTION=$1
    shift
    ;;
  -*)
    # If the first argument is an option, it's the default 'install' action
    ACTION="install"
    ;;
esac

while [[ $# -gt 0 ]]; do
  case $1 in
    --tags)
      TAGS="$2"
      shift 2
      ;;
    --skip-become-pass)
      SKIP_BECOME_PASS="--skip-become-pass"
      shift
      ;;
    --start-at-task)
      START_AT_TASK="$2"
      shift 2
      ;;
    *)
      if [ "$TAGS" == "all" ]; then
        TAGS="$1"
      elif [ -z "$SKIP_BECOME_PASS" ] && [[ "$1" == "--skip-become-pass" ]]; then
        SKIP_BECOME_PASS="--skip-become-pass"
      elif [ -z "$START_AT_TASK" ]; then
        START_AT_TASK="$1"
      fi
      shift
      ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(dirname "$SCRIPT_DIR")"

# Ensure Ansible is installed
if ! [ -x "$(command -v ansible)" ]; then
  if [[ "$OSTYPE" == "darwin"* ]]; then
    brew install ansible
  elif command -v apt-get &> /dev/null; then
    sudo apt-get update && sudo apt-get install -y ansible
  fi
fi

# Install dependencies
ansible-galaxy install -r "$DOTFILES_DIR/requirements.yml"

ANSIBLE_OPTS=()

case $ACTION in
  install)
    PLAYBOOK="$DOTFILES_DIR/dotfiles.yml"
    ANSIBLE_OPTS+=("--tags" "$TAGS")
    ;;
  uninstall)
    PLAYBOOK="$DOTFILES_DIR/dotfiles.yml"
    ANSIBLE_OPTS+=("--tags" "$TAGS" "-e" "dotfiles_action=uninstall")
    ;;
  check-updates)
    PLAYBOOK="$DOTFILES_DIR/update-check.yml"
    if [ "$TAGS" != "all" ]; then
      ANSIBLE_OPTS+=("--tags" "$TAGS")
    fi
    ;;
  upgrade)
    if [ "$TAGS" == "all" ]; then
      echo "Error: Please specify a role to upgrade (e.g., dot-bootstrap upgrade golang)."
      exit 1
    fi
    exec "$DOTFILES_DIR/bin/dot-upgrade" "$TAGS"
    ;;
esac


if [ -n "$START_AT_TASK" ]; then
  ANSIBLE_OPTS+=("--start-at-task" "$START_AT_TASK")
fi

echo "Action: $ACTION"
if [ "$ACTION" != "check-updates" ]; then
  echo "Tags: $TAGS"
fi

if [ "$SKIP_BECOME_PASS" == "--skip-become-pass" ] || [ "$ACTION" == "check-updates" ]; then
  ansible-playbook -i "$DOTFILES_DIR/hosts" "$PLAYBOOK" "${ANSIBLE_OPTS[@]}"
elif [ -n "$ANSIBLE_BECOME_PASSWORD_FILE" ]; then
  ansible-playbook -i "$DOTFILES_DIR/hosts" "$PLAYBOOK" --become-password-file "$ANSIBLE_BECOME_PASSWORD_FILE" "${ANSIBLE_OPTS[@]}"
else
  ansible-playbook -i "$DOTFILES_DIR/hosts" "$PLAYBOOK" --ask-become-pass "${ANSIBLE_OPTS[@]}"
fi


