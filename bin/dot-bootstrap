#!/usr/bin/env bash
set -e

tags="$1"

if [ -z "$tags" ]; then
  tags="all"
fi

if ! [ -x "$(command -v ansible)" ]; then
  brew install ansible
fi

ansible-galaxy install -r requirements.yml
if [ -n "$ANSIBLE_BECOME_PASSWORD_FILE" ]; then
  ansible-playbook -i ~/.dotfiles/hosts ~/.dotfiles/dotfiles.yml --tags "$tags" ${2:+--start-at-task "$2"}
else
  ansible-playbook -i ~/.dotfiles/hosts ~/.dotfiles/dotfiles.yml --ask-become-pass --tags "$tags" ${2:+--start-at-task "$2"}
fi

if command -v terminal-notifier 1>/dev/null 2>&1; then
  terminal-notifier -title "dotfiles: Bootstrap complete" -message "Successfully set up dev environment."
fi
