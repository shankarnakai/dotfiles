[user]
        name = {{ full_name }}
        email = {{ personal_git_email }}
[alias]
        a = add
        st = status
        s = status
        co = checkout
        cob = checkout -b
        c = checkout
        ci = commit
        noff = merge --no-ff
        plr = pull --rebase
        amend = commit --amend
        wip = commit --no-verify -am "WIP"
        br = branch
        rn = branch -m
        # diff-so-fancy
        # https://github.com/so-fancy/diff-so-fancy/#usage
        df = "!f() { [ -z \"$GIT_PREFIX\" ] || cd \"$GIT_PREFIX\" && git diff --color \"$@\" | diff-so-fancy  | less --tabs=4 -RFX; }; f"
        dfs = df --staged
        # Get changes for a single commit
        dfc = "!dfc() { git df $1^ $1; }; dfc"

        please = push --force-with-lease
        #publish = "!git push -u origin $(git rev-parse --abbrev-ref HEAD)"
        # publish current branch
        publish = "!f() { git push -u ${1:-origin} $(git rev-parse --abbrev-ref HEAD); }; f"

        # http://gggritso.com/human-git-aliases
        unstage = reset -q HEAD --
        discard = checkout --
        nevermind = checkout . 
        uncommit = reset --mixed HEAD~

        # https://stackoverflow.com/questions/4114095/how-do-i-revert-a-git-repository-to-a-previous-commit
        rv= "!f() { git revert --no-commit $1~1..HEAD; git reset; git status; }; f"

        l = log --graph --decorate --oneline --abbrev-commit --all
        h = log --graph --decorate --oneline --abbrev-commit

        #issues = !hub browse -- issues
        # Forge-aware web URLs via myrepoctl (~/.dotfiles/bin), works for
        # GitHub, Bitbucket, and GitLab. Prints by default; -o opens the browser.
        url = "!myrepoctl url"
        browse = "!myrepoctl repo -o"
        pr = "!myrepoctl pr -o"
        create-pr = "!myrepoctl create-pr -o"
        commitlink = "!f() { myrepoctl commit \"$1\" -o; }; f"
        file-link = "!f() { myrepoctl file \"$1\"; }; f"

        # Copy current branch name to clipboard (macOS only)
        cb = "!git rev-parse --abbrev-ref HEAD | tr -d '\n' | pbcopy"

        remote-branches = "!f() { git ls-remote --heads ${1:origin} | sed 's?.*refs/heads/??'; }; f "
[color]
        diff = auto
        status = auto
        ui = true

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[core]
        excludesfile = ~/.gitignore_global
        editor = nvim
        hooksPath = ~/.config/git/hooks/
[apply]
        whitespace = nowarn
[mergetool]
        keepBackup = false
[difftool]
        prompt = false
[push]
        # See `git help config` (search for push.default)
        # for more information on different options of the below setting.
        #
        # Setting to git 2.0 default to surpress warning message
        default = simple
        followTags = true

{% if ansible_os_family == 'Darwin' and not (lookup('env', 'CI') | default(false, true)) %}
# URL rewrites: work org routes to github-work SSH alias (longest prefix wins)
{% for org in github_work_orgs %}
[url "git@github-work:{{ org }}/"]
    insteadOf = git@github.com:{{ org }}/
    insteadOf = https://github.com/{{ org }}/

{% endfor %}

# All other GitHub HTTPS URLs → SSH (uses personal key via Host github.com)
[url "git@github.com:"]
    insteadOf = https://github.com/

[url "git@bitbucket.org:"]
    insteadOf = https://bitbucket.org/
{% endif %}

# Conditional includes (Git >= 2.36)
[includeIf "hasconfig:remote.*.url:git@github-work:**"]
    path = ~/.gitconfig-work

[includeIf "hasconfig:remote.*.url:git@bitbucket.org:**"]
    path = ~/.gitconfig-work
