# Managed by Ansible (roles/git) — do not edit manually

Host github-work
    HostName github.com
    User git
    IdentityFile ~/.ssh/{{ github_work_ssh_key_filename }}
    IdentitiesOnly yes

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/{{ github_personal_ssh_key_filename }}
    IdentitiesOnly yes

Host bitbucket.org
    HostName bitbucket.org
    User git
    IdentityFile ~/.ssh/{{ bitbucket_work_ssh_key_filename }}
    IdentitiesOnly yes

Host *
    AddKeysToAgent yes
    UseKeychain yes
