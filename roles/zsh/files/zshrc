export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="agnoster"
plugins=(git kubectl aws)

source "$ZSH/oh-my-zsh.sh"

# FZF keybindings and completion
if command -v brew &>/dev/null; then
  _fzf_prefix="$(brew --prefix fzf)/shell"
  [ -f "$_fzf_prefix/key-bindings.zsh" ] && source "$_fzf_prefix/key-bindings.zsh"
  [ -f "$_fzf_prefix/completion.zsh" ] && source "$_fzf_prefix/completion.zsh"
  unset _fzf_prefix
elif [ -d "/usr/share/doc/fzf/examples" ]; then
  # Common Ubuntu fzf example paths
  [ -f "/usr/share/doc/fzf/examples/key-bindings.zsh" ] && source "/usr/share/doc/fzf/examples/key-bindings.zsh"
  [ -f "/usr/share/doc/fzf/examples/completion.zsh" ] && source "/usr/share/doc/fzf/examples/completion.zsh"
fi

export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
command -v pyenv &>/dev/null && eval "$(pyenv init - zsh)"

source "$HOME/.dotfiles/roles/zsh/functions.zsh"
source "$HOME/.dotfiles/roles/zsh/aliases.zsh"
source "$HOME/.dotfiles/roles/zsh/completion.zsh"
source "$HOME/.dotfiles/roles/zsh/config.zsh"
source "$HOME/.dotfiles/roles/zsh/env.zsh"
source "$HOME/.dotfiles/roles/zsh/path.zsh"

if [ -f "$HOME/.localrc" ]; then
  source "$HOME/.localrc"
fi

fpath+=("$HOME/.zfunc" "$HOME/.dotfiles/roles/zsh/functions")
autoload -Uz compinit && compinit

export PATH="$PATH:$HOME/.local/bin"
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# pnpm
if [[ "$OSTYPE" == "darwin"* ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
else
  export PNPM_HOME="$HOME/.local/share/pnpm"
fi

case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# Atelier - Shared context for Claude Code
atelier() {
    cd "$HOME/projects/atelier" && git pull --quiet && claude
}
export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
